# =============================================================================
#  Hyprland — minimal, dark
# -----------------------------------------------------------------------------
#  A small, self-contained Hyprland setup. No shell/bar: everything is
#  keyboard-driven through rofi. kitty is the terminal, hyprlock + hypridle do
#  lock and idle, and one dark palette is used across every generated config.
#
#  The compositor reads its Lua config from /etc/xdg/hypr/hyprland.lua.
# =============================================================================
{ pkgs, lib, ... }:

let
  # -- Palette ---------------------------------------------------------------
  # Near-black greys with a single soft blue accent. Keep it tiny: every colour
  # below is used, and nothing else is themed.
  bg     = "0d0d0f";   # window/terminal background
  bg1    = "141417";   # slightly raised
  bg2    = "1b1b20";   # menus, lock
  bg3    = "26262d";   # borders, selections
  fg     = "d6d6dd";   # primary text
  dim    = "7d7d8a";   # secondary text
  accent = "8ab4f8";   # the one accent
  green  = "a3d977";
  yellow = "e6c07b";
  red    = "e06c75";

  # -- Apps ------------------------------------------------------------------
  terminal = "kitty";
  menu     = "rofi -show drun -config /etc/xdg/rofi/config.rasi";
  browser  = "xdg-open https://";
  font     = "JetBrainsMono Nerd Font";

  # =========================================================================
  #  Hyprland
  # =========================================================================
  hyprlandLua = ''
    -- minimal dark — generated by hyprland.nix

    local terminal = "${terminal}"
    local menu     = "${menu}"
    local browser  = "${browser}"
    local mainMod  = "SUPER"

    hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })

    hl.env("XCURSOR_THEME",    "Adwaita")
    hl.env("XCURSOR_SIZE",     "24")
    hl.env("HYPRCURSOR_THEME", "Adwaita")
    hl.env("HYPRCURSOR_SIZE",  "24")

    hl.config({
      general = {
        gaps_in          = 4,
        gaps_out         = 8,
        border_size      = 2,
        resize_on_border = true,
        layout           = "dwindle",
        col = {
          active_border   = { colors = { "rgba(${accent}ee)", "rgba(${accent}77)" }, angle = 45 },
          inactive_border = "rgba(${bg3}aa)",
        },
      },
      decoration = {
        rounding         = 6,
        rounding_power   = 2,
        active_opacity   = 1.0,
        inactive_opacity = 0.97,
        shadow = { enabled = true, range = 6, render_power = 3, color = 0xee000000 },
        blur   = { enabled = false },
      },
      animations = { enabled = true },
      dwindle    = { preserve_split = true },
      misc       = { force_default_wallpaper = 0, disable_hyprland_logo = true },
      input = {
        kb_layout      = "us",
        repeat_rate    = 40,
        repeat_delay   = 400,
        follow_mouse   = 1,
        sensitivity    = 0,
        accel_profile  = "flat",
        force_no_accel = false,
        touchpad       = { natural_scroll = false },
      },
      cursor = { no_hardware_cursors = true, use_cpu_buffer = true },
    })

    hl.curve("ease", { type = "bezier", points = { {0.25, 0.1}, {0.25, 1} } })
    hl.animation({ leaf = "windows",    enabled = true, speed = 4, bezier = "ease" })
    hl.animation({ leaf = "windowsOut", enabled = true, speed = 3, bezier = "ease" })
    hl.animation({ leaf = "fade",       enabled = true, speed = 4, bezier = "ease" })
    hl.animation({ leaf = "workspaces", enabled = true, speed = 4, bezier = "ease" })
    hl.animation({ leaf = "border",     enabled = true, speed = 5, bezier = "ease" })

    ----------------------------------------------------------------
    ---- APPS ------------------------------------------------------
    ----------------------------------------------------------------
    hl.bind(mainMod .. " + Return", hl.dsp.exec_cmd(terminal))
    hl.bind(mainMod .. " + D",      hl.dsp.exec_cmd(menu))
    hl.bind(mainMod .. " + B",      hl.dsp.exec_cmd(browser))
    hl.bind(mainMod .. " + L",      hl.dsp.exec_cmd("hyprlock"))
    hl.bind(mainMod .. " + W",      hl.dsp.exec_cmd("rofi -show window -config /etc/xdg/rofi/config.rasi"))

    ----------------------------------------------------------------
    ---- WINDOWS ---------------------------------------------------
    ----------------------------------------------------------------
    hl.bind(mainMod .. " + Q",         hl.dsp.window.close())
    hl.bind(mainMod .. " + SHIFT + Q", hl.dsp.window.kill())
    hl.bind(mainMod .. " + F",         hl.dsp.window.fullscreen())
    hl.bind(mainMod .. " + V",         hl.dsp.window.float({ action = "toggle" }))
    hl.bind(mainMod .. " + P",         hl.dsp.window.pseudo())
    hl.bind(mainMod .. " + T",         hl.dsp.layout("togglesplit"))

    ----------------------------------------------------------------
    ---- FOCUS -----------------------------------------------------
    ----------------------------------------------------------------
    hl.bind(mainMod .. " + left",  hl.dsp.focus({ direction = "left" }))
    hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "right" }))
    hl.bind(mainMod .. " + up",    hl.dsp.focus({ direction = "up" }))
    hl.bind(mainMod .. " + down",  hl.dsp.focus({ direction = "down" }))
    hl.bind(mainMod .. " + h",     hl.dsp.focus({ direction = "left" }))
    hl.bind(mainMod .. " + l",     hl.dsp.focus({ direction = "right" }))
    hl.bind(mainMod .. " + k",     hl.dsp.focus({ direction = "up" }))
    hl.bind(mainMod .. " + j",     hl.dsp.focus({ direction = "down" }))

    hl.bind(mainMod .. " + SHIFT + left",  hl.dsp.window.move({ direction = "left" }))
    hl.bind(mainMod .. " + SHIFT + right", hl.dsp.window.move({ direction = "right" }))
    hl.bind(mainMod .. " + SHIFT + up",    hl.dsp.window.move({ direction = "up" }))
    hl.bind(mainMod .. " + SHIFT + down",  hl.dsp.window.move({ direction = "down" }))

    ----------------------------------------------------------------
    ---- WORKSPACES ------------------------------------------------
    ----------------------------------------------------------------
    for i = 1, 9 do
      hl.bind(mainMod .. " + " .. i,         hl.dsp.focus({ workspace = i }))
      hl.bind(mainMod .. " + SHIFT + " .. i, hl.dsp.window.move({ workspace = i }))
    end
    hl.bind(mainMod .. " + Tab",         hl.dsp.focus({ workspace = "e+1" }))
    hl.bind(mainMod .. " + SHIFT + Tab", hl.dsp.focus({ workspace = "e-1" }))
    hl.bind(mainMod .. " + mouse_down",  hl.dsp.focus({ workspace = "e+1" }))
    hl.bind(mainMod .. " + mouse_up",    hl.dsp.focus({ workspace = "e-1" }))

    ----------------------------------------------------------------
    ---- MEDIA / VOLUME / BRIGHTNESS -------------------------------
    ----------------------------------------------------------------
    hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
    hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { locked = true, repeating = true })
    hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     { locked = true, repeating = true })
    hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"),                  { locked = true, repeating = true })
    hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"),                  { locked = true, repeating = true })
    hl.bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       { locked = true })
    hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
    hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
    hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   { locked = true })

    ----------------------------------------------------------------
    ---- QUIT ------------------------------------------------------
    ----------------------------------------------------------------
    hl.bind(mainMod .. " + M", hl.dsp.exit())

    ----------------------------------------------------------------
    ---- WINDOW RULES ----------------------------------------------
    ----------------------------------------------------------------
    hl.window_rule({ name = "float-pavucontrol", match = { class = "pavucontrol" }, float = true })
    hl.window_rule({ name = "float-nm",          match = { class = "nm-connection-editor" }, float = true })
  '';

  # =========================================================================
  #  rofi — the launcher / menu
  # =========================================================================
  rofiConfig = ''
    configuration {
      modi             = "drun,run,window";
      show-icons       = true;
      icon-theme       = "Papirus-Dark";
      font             = "${font} 11";
      terminal         = "${terminal}";
      drun-display-format = "{name}";
      disable-history  = false;
      sorting-method   = "fzf";
    }
    @theme "/etc/xdg/rofi/theme.rasi"
  '';

  rofiTheme = ''
    * {
      bg:      #${bg2};
      bg-alt:  #${bg3};
      fg:      #${fg};
      dim:     #${dim};
      accent:  #${accent};
      red:     #${red};
      background-color: transparent;
      text-color: @fg;
      border-color: @accent;
    }

    window {
      width:           32%;
      padding:         10px;
      border:          2px;
      border-radius:   8px;
      background-color: @bg;
      border-color:    @accent;
    }

    mainbox { children: [ inputbar, listview ]; spacing: 8px; }

    inputbar {
      children:   [ prompt, entry ];
      padding:    8px 10px;
      background-color: @bg-alt;
      border-radius: 6px;
    }
    prompt { text-color: @accent; padding: 0 8px 0 0; }
    entry  { text-color: @fg; placeholder: "Search…"; placeholder-color: @dim; }

    listview { lines: 8; spacing: 4px; scrollbar: false; }
    element  { padding: 7px 10px; border-radius: 6px; }
    element selected { background-color: @bg-alt; text-color: @accent; }
    element-text { text-color: inherit; }
    element-icon { size: 1.2em; }
  '';

  # =========================================================================
  #  hyprlock — screen lock
  # =========================================================================
  hyprlockConf = ''
    background {
      monitor =
      color = rgba(${bg}ff)
    }

    input-field {
      monitor =
      size = 240, 44
      outline_thickness = 2
      rounding = 8
      dots_size = 0.25
      dots_spacing = 0.35
      dots_center = true
      outer_color = rgba(${accent}ff)
      inner_color = rgba(${bg2}ff)
      font_color = rgba(${fg}ff)
      placeholder_text = <span foreground="##${dim}">Password…</span>
      fail_text = <span foreground="##${red}">Wrong</span>
      fade_on_empty = false
      position = 0, -80
      halign = center
      valign = center
    }

    label {
      monitor =
      text = $TIME
      color = rgba(${fg}ff)
      font_size = 72
      font_family = ${font}
      position = 0, 40
      halign = center
      valign = center
    }
  '';

  # =========================================================================
  #  hypridle — blank + lock on idle
  # =========================================================================
  hypridleConf = ''
    general {
      lock_cmd = pidof hyprlock || hyprlock
      before_sleep_cmd = loginctl lock-session
    }

    listener {
      timeout = 300
      on-timeout = pidof hyprlock || hyprlock
    }
    listener {
      timeout = 360
      on-timeout = hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = true })'
      on-resume = hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = false })'
    }
  '';

  # =========================================================================
  #  kitty — terminal
  # =========================================================================
  kittyConf = ''
    font_family      ${font}
    font_size        11.0
    cursor_shape     beam

    background       #${bg}
    foreground       #${fg}
    selection_background #${bg3}
    selection_foreground #${fg}
    cursor           #${accent}

    color0  #${bg2}
    color8  #${bg3}
    color1  #${red}
    color9  #${red}
    color2  #${green}
    color10 #${green}
    color3  #${yellow}
    color11 #${yellow}
    color4  #${accent}
    color12 #${accent}
    color5  #${accent}
    color13 #${accent}
    color6  #${accent}
    color14 #${accent}
    color7  #${fg}
    color15 #${fg}

    window_padding_width 8
    confirm_os_window_close 0
  '';
in
{
  programs.hyprland = {
    enable = true;
    xwayland.enable = true;
  };

  environment.etc = {
    "xdg/hypr/hyprland.lua".text   = hyprlandLua;
    "xdg/hypr/hyprlock.conf".text  = hyprlockConf;
    "xdg/hypr/hypridle.conf".text  = hypridleConf;
    "xdg/rofi/config.rasi".text    = rofiConfig;
    "xdg/rofi/theme.rasi".text     = rofiTheme;
    "xdg/kitty/kitty.conf".text    = kittyConf;
  };

  environment.systemPackages = with pkgs; [
    kitty
    rofi
    hyprlock
    hypridle
    hyprpaper
    brightnessctl
    playerctl
    pavucontrol
    networkmanagerapplet
    wl-clipboard
    grim
    slurp
  ];
}
