# =============================================================================
#  Hyprland — minimal, dark
# -----------------------------------------------------------------------------
#  A small, self-contained Hyprland setup. No shell/bar: everything is
#  keyboard-driven through rofi. kitty is the terminal, hyprlock + hypridle do
#  lock and idle, and one dark palette is used across every generated config.
#
#  The compositor reads its Lua config from /etc/xdg/hypr/hyprland.lua.
# =============================================================================
{ pkgs, lib, ... }:

let
  # -- Palette ---------------------------------------------------------------
  # Near-black greys with a single soft blue accent. Keep it tiny: every colour
  # below is used, and nothing else is themed.
  bg     = "0d0d0f";   # window/terminal background
  bg1    = "141417";   # slightly raised
  bg2    = "1b1b20";   # menus, lock
  bg3    = "26262d";   # borders, selections
  fg     = "d6d6dd";   # primary text
  dim    = "7d7d8a";   # secondary text
  accent = "8ab4f8";   # the one accent
  green  = "a3d977";
  yellow = "e6c07b";
  red    = "e06c75";

  # -- Apps ------------------------------------------------------------------
  terminal = "kitty";
  menu     = "rofi -show drun -config $HOME/.config/rofi/config.rasi";
  browser  = "qutebrowser";
  font     = "JetBrainsMono Nerd Font";

  # -- Themes ----------------------------------------------------------------
  # A theme is a palette plus the NixOS wallpaper that matches it. Every file
  # below is authored in the `slate` palette (the named colours at the top) and
  # each other theme is produced by swapping those exact values out with
  # `recolor`, so adding a theme means adding one entry here.
  themes = {
    slate = { bg = "0d0d0f"; bg1 = "141417"; bg2 = "1b1b20"; bg3 = "26262d";
              fg = "d6d6dd"; dim = "7d7d8a"; accent = "8ab4f8";
              green = "a3d977"; yellow = "e6c07b"; red = "e06c75";
              wallpaper = "gear"; };
    mocha = { bg = "1e1e2e"; bg1 = "181825"; bg2 = "313244"; bg3 = "45475a";
              fg = "cdd6f4"; dim = "a6adc8"; accent = "cba6f7";
              green = "a6e3a1"; yellow = "f9e2af"; red = "f38ba8";
              wallpaper = "catppuccin-mocha"; };
    macchiato = { bg = "24273a"; bg1 = "1e2030"; bg2 = "363a4f"; bg3 = "494d64";
              fg = "cad3f5"; dim = "a5adcb"; accent = "c6a0f6";
              green = "a6da95"; yellow = "eed49f"; red = "ed8796";
              wallpaper = "catppuccin-macchiato"; };
    dracula = { bg = "282a36"; bg1 = "21222c"; bg2 = "343746"; bg3 = "44475a";
              fg = "f8f8f2"; dim = "6272a4"; accent = "bd93f9";
              green = "50fa7b"; yellow = "f1fa8c"; red = "ff5555";
              wallpaper = "dracula"; };
    nord = { bg = "2e3440"; bg1 = "3b4252"; bg2 = "434c5e"; bg3 = "4c566a";
              fg = "d8dee9"; dim = "81a1c1"; accent = "88c0d0";
              green = "a3be8c"; yellow = "ebcb8b"; red = "bf616a";
              wallpaper = "simple-dark-gray"; };
    tokyonight = { bg = "1a1b26"; bg1 = "16161e"; bg2 = "292e42"; bg3 = "3b4261";
              fg = "c0caf5"; dim = "565f89"; accent = "7aa2f7";
              green = "9ece6a"; yellow = "e0af68"; red = "f7768e";
              wallpaper = "mosaic-blue"; };
  };

  wallpaperOf = w:
    "${pkgs.nixos-artwork.wallpapers.${w}}/share/wallpapers/${w}/contents/images/nix-wallpaper-${w}.png";

  # replaceStrings scans the input once and never rescans its own output, so a
  # replacement value can never be replaced again.
  base = themes.slate;
  recolor = pal: builtins.replaceStrings
    [ base.bg base.bg1 base.bg2 base.bg3 base.fg base.dim base.accent base.green base.yellow base.red ]
    [ pal.bg  pal.bg1  pal.bg2  pal.bg3  pal.fg  pal.dim  pal.accent  pal.green  pal.yellow  pal.red ];

  # =========================================================================
  #  Hyprland
  # =========================================================================
  hyprlandLua = ''
    -- minimal dark — generated by hyprland.nix

    local terminal = "${terminal}"
    local menu     = "${menu}"
    local browser  = "${browser}"
    local mainMod  = "SUPER"

    hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })

    hl.env("XCURSOR_THEME",    "Adwaita")
    hl.env("XCURSOR_SIZE",     "24")
    hl.env("HYPRCURSOR_THEME", "Adwaita")
    hl.env("HYPRCURSOR_SIZE",  "24")

    hl.config({
      general = {
        gaps_in          = 4,
        gaps_out         = 8,
        border_size      = 2,
        resize_on_border = true,
        layout           = "dwindle",
        col = {
          active_border   = { colors = { "rgba(${accent}ee)", "rgba(${accent}77)" }, angle = 45 },
          inactive_border = "rgba(${bg3}aa)",
        },
      },
      decoration = {
        rounding         = 6,
        rounding_power   = 2,
        active_opacity   = 1.0,
        inactive_opacity = 0.97,
        shadow = { enabled = true, range = 6, render_power = 3, color = 0xee000000 },
        blur   = { enabled = false },
      },
      animations = { enabled = true },
      dwindle    = { preserve_split = true },
      misc       = { force_default_wallpaper = 0, disable_hyprland_logo = true },
      input = {
        kb_layout      = "us",
        repeat_rate    = 40,
        repeat_delay   = 400,
        follow_mouse   = 1,
        sensitivity    = 0,
        accel_profile  = "flat",
        force_no_accel = false,
        touchpad       = { natural_scroll = false },
      },
      cursor = { no_hardware_cursors = true, use_cpu_buffer = true },
    })

    hl.curve("ease", { type = "bezier", points = { {0.25, 0.1}, {0.25, 1} } })
    hl.animation({ leaf = "windows",    enabled = true, speed = 4, bezier = "ease" })
    hl.animation({ leaf = "windowsOut", enabled = true, speed = 3, bezier = "ease" })
    hl.animation({ leaf = "fade",       enabled = true, speed = 4, bezier = "ease" })
    hl.animation({ leaf = "workspaces", enabled = true, speed = 4, bezier = "ease" })
    hl.animation({ leaf = "border",     enabled = true, speed = 5, bezier = "ease" })

    ----------------------------------------------------------------
    ---- APPS ------------------------------------------------------
    ----------------------------------------------------------------
    hl.bind(mainMod .. " + Return", hl.dsp.exec_cmd(terminal))
    hl.bind(mainMod .. " + D",      hl.dsp.exec_cmd(menu))
    hl.bind(mainMod .. " + B",      hl.dsp.exec_cmd(browser))
    hl.bind(mainMod .. " + L",      hl.dsp.exec_cmd("hyprlock"))
    hl.bind(mainMod .. " + W",      hl.dsp.exec_cmd("rofi -show window -config $HOME/.config/rofi/config.rasi"))
    hl.bind(mainMod .. " + SHIFT + M", hl.dsp.exec_cmd("music-menu"))
    hl.bind(mainMod .. " + SHIFT + T", hl.dsp.exec_cmd("theme-switch"))

    ----------------------------------------------------------------
    ---- WINDOWS ---------------------------------------------------
    ----------------------------------------------------------------
    hl.bind(mainMod .. " + Q",         hl.dsp.window.close())
    hl.bind(mainMod .. " + SHIFT + Q", hl.dsp.window.kill())
    hl.bind(mainMod .. " + F",         hl.dsp.window.fullscreen())
    hl.bind(mainMod .. " + V",         hl.dsp.window.float({ action = "toggle" }))
    hl.bind(mainMod .. " + P",         hl.dsp.window.pseudo())
    hl.bind(mainMod .. " + T",         hl.dsp.layout("togglesplit"))

    ----------------------------------------------------------------
    ---- FOCUS -----------------------------------------------------
    ----------------------------------------------------------------
    hl.bind(mainMod .. " + left",  hl.dsp.focus({ direction = "left" }))
    hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "right" }))
    hl.bind(mainMod .. " + up",    hl.dsp.focus({ direction = "up" }))
    hl.bind(mainMod .. " + down",  hl.dsp.focus({ direction = "down" }))
    hl.bind(mainMod .. " + h",     hl.dsp.focus({ direction = "left" }))
    hl.bind(mainMod .. " + l",     hl.dsp.focus({ direction = "right" }))
    hl.bind(mainMod .. " + k",     hl.dsp.focus({ direction = "up" }))
    hl.bind(mainMod .. " + j",     hl.dsp.focus({ direction = "down" }))

    hl.bind(mainMod .. " + SHIFT + left",  hl.dsp.window.move({ direction = "left" }))
    hl.bind(mainMod .. " + SHIFT + right", hl.dsp.window.move({ direction = "right" }))
    hl.bind(mainMod .. " + SHIFT + up",    hl.dsp.window.move({ direction = "up" }))
    hl.bind(mainMod .. " + SHIFT + down",  hl.dsp.window.move({ direction = "down" }))

    ----------------------------------------------------------------
    ---- WORKSPACES ------------------------------------------------
    ----------------------------------------------------------------
    for i = 1, 9 do
      hl.bind(mainMod .. " + " .. i,         hl.dsp.focus({ workspace = i }))
      hl.bind(mainMod .. " + SHIFT + " .. i, hl.dsp.window.move({ workspace = i }))
    end
    hl.bind(mainMod .. " + Tab",         hl.dsp.focus({ workspace = "e+1" }))
    hl.bind(mainMod .. " + SHIFT + Tab", hl.dsp.focus({ workspace = "e-1" }))
    hl.bind(mainMod .. " + mouse_down",  hl.dsp.focus({ workspace = "e+1" }))
    hl.bind(mainMod .. " + mouse_up",    hl.dsp.focus({ workspace = "e-1" }))

    ----------------------------------------------------------------
    ---- MEDIA / VOLUME / BRIGHTNESS -------------------------------
    ----------------------------------------------------------------
    hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
    hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { locked = true, repeating = true })
    hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     { locked = true, repeating = true })
    hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"),                  { locked = true, repeating = true })
    hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"),                  { locked = true, repeating = true })
    hl.bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       { locked = true })
    hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
    hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
    hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   { locked = true })

    ----------------------------------------------------------------
    ---- QUIT ------------------------------------------------------
    ----------------------------------------------------------------
    hl.bind(mainMod .. " + M", hl.dsp.exit())

    ----------------------------------------------------------------
    ---- WINDOW RULES ----------------------------------------------
    ----------------------------------------------------------------
    -- Apps (kitty, games, ...) ask the compositor to maximize themselves, which
    -- makes them cover the tiled windows. Ignore those requests so everything
    -- stays tiled; SUPER+F still fullscreens a window on demand.
    hl.window_rule({ name = "suppress-maximize-events", match = { class = ".*" }, suppress_event = "maximize" })

    hl.window_rule({ name = "float-pavucontrol", match = { class = "pavucontrol" }, float = true })
    hl.window_rule({ name = "float-nm",          match = { class = "nm-connection-editor" }, float = true })
  '';

  # =========================================================================
  #  rofi — the launcher / menu
  # =========================================================================
  # rofi 2.0: the config file is itself a rasi theme, and @theme does not
  # resolve, so the configuration block and the theme live in one file. The
  # element colours come from the named variables (normal-background, ...),
  # not a plain `element { }`, which is why they must be set here.
  rofiConfig = ''
    configuration {
      modi:            "drun,run,window";
      show-icons:      true;
      icon-theme:      "Papirus-Dark";
      font:            "${font} 11";
      terminal:        "${terminal}";
      disable-history: false;
    }

    * {
      background:                  #${bg};
      background-color:            transparent;
      foreground:                  #${fg};
      normal-background:           #${bg};
      normal-foreground:           #${fg};
      alternate-normal-background: #${bg1};
      alternate-normal-foreground: @foreground;
      selected-normal-background:  #${bg3};
      selected-normal-foreground:  #${accent};
      active-background:           #${bg1};
      active-foreground:           #${accent};
      selected-active-background:  #${bg3};
      selected-active-foreground:  #${accent};
      urgent-background:           #${bg1};
      urgent-foreground:           #${red};
      selected-urgent-background:  #${bg3};
      selected-urgent-foreground:  #${red};
      border-color:                #${accent};
      separatorcolor:              #${bg3};
      spacing:                     6;
    }
    window { width: 32%; padding: 10px; border: 2px; border-radius: 8px; background-color: #${bg}; }
    mainbox { border: 0; padding: 0; }
    inputbar { children: [ prompt, entry ]; padding: 8px 10px; background-color: #${bg1}; border-radius: 6px; }
    prompt { text-color: #${accent}; padding: 0 8px 0 0; }
    entry { text-color: #${fg}; }
    listview { lines: 8; spacing: 4px; scrollbar: false; border: 0; padding: 2px 0 0; }
    element { padding: 7px 10px; border-radius: 6px; }
    element-text { background-color: inherit; text-color: inherit; }
  '';

  # =========================================================================
  #  hyprlock — screen lock
  # =========================================================================
  hyprlockConf = ''
    background {
      monitor =
      color = rgba(${bg}ff)
    }

    input-field {
      monitor =
      size = 240, 44
      outline_thickness = 2
      rounding = 8
      dots_size = 0.25
      dots_spacing = 0.35
      dots_center = true
      outer_color = rgba(${accent}ff)
      inner_color = rgba(${bg2}ff)
      font_color = rgba(${fg}ff)
      placeholder_text = <span foreground="##${dim}">Password…</span>
      fail_text = <span foreground="##${red}">Wrong</span>
      fade_on_empty = false
      position = 0, -80
      halign = center
      valign = center
    }

    label {
      monitor =
      text = $TIME
      color = rgba(${fg}ff)
      font_size = 72
      font_family = ${font}
      position = 0, 40
      halign = center
      valign = center
    }
  '';

  # =========================================================================
  #  hypridle — blank + lock on idle
  # =========================================================================
  hypridleConf = ''
    general {
      lock_cmd = pidof hyprlock || hyprlock
      before_sleep_cmd = loginctl lock-session
    }

    listener {
      timeout = 300
      on-timeout = pidof hyprlock || hyprlock
    }
    listener {
      timeout = 360
      on-timeout = hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = true })'
      on-resume = hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = false })'
    }
  '';

  # =========================================================================
  #  kitty — terminal
  # =========================================================================
  kittyConf = ''
    font_family      ${font}
    font_size        11.0
    cursor_shape     beam

    background       #${bg}
    foreground       #${fg}
    selection_background #${bg3}
    selection_foreground #${fg}
    cursor           #${accent}

    color0  #${bg2}
    color8  #${bg3}
    color1  #${red}
    color9  #${red}
    color2  #${green}
    color10 #${green}
    color3  #${yellow}
    color11 #${yellow}
    color4  #${accent}
    color12 #${accent}
    color5  #${accent}
    color13 #${accent}
    color6  #${accent}
    color14 #${accent}
    color7  #${fg}
    color15 #${fg}

    window_padding_width 8
    confirm_os_window_close 0
  '';

  # =========================================================================
  #  qutebrowser — the slate palette, applied to the whole browser
  # =========================================================================
  # A single config.py drives the chrome colours, the completion menu, hints
  # and the built-in dark mode, so qutebrowser matches the rest of the desktop.
  qutebrowserConfig = ''
    # generated by hyprland.nix — slate theme
    config.load_autoconfig(False)

    bg, bg1, bg2, bg3 = "#0d0d0f", "#141417", "#1b1b20", "#26262d"
    fg, dim, accent   = "#d6d6dd", "#7d7d8a", "#8ab4f8"
    green, yellow, red = "#a3d977", "#e6c07b", "#e06c75"

    # -- fonts -------------------------------------------------------------
    c.fonts.default_family = "JetBrainsMono Nerd Font"
    c.fonts.default_size = "10pt"
    c.fonts.hints = "bold 10pt JetBrainsMono Nerd Font"

    # -- status bar --------------------------------------------------------
    c.colors.statusbar.normal.bg = bg
    c.colors.statusbar.normal.fg = fg
    c.colors.statusbar.insert.bg = accent
    c.colors.statusbar.insert.fg = bg
    c.colors.statusbar.command.bg = bg2
    c.colors.statusbar.command.fg = fg
    c.colors.statusbar.url.fg = dim
    c.colors.statusbar.url.success.https.fg = accent
    c.colors.statusbar.url.hover.fg = accent
    c.colors.statusbar.progress.bg = accent

    # -- tabs --------------------------------------------------------------
    c.colors.tabs.bar.bg = bg
    c.colors.tabs.odd.bg = bg1
    c.colors.tabs.even.bg = bg1
    c.colors.tabs.odd.fg = dim
    c.colors.tabs.even.fg = dim
    c.colors.tabs.selected.odd.bg = bg3
    c.colors.tabs.selected.even.bg = bg3
    c.colors.tabs.selected.odd.fg = fg
    c.colors.tabs.selected.even.fg = fg
    c.colors.tabs.indicator.start = accent
    c.colors.tabs.indicator.stop = accent
    c.colors.tabs.indicator.error = red

    # -- completion menu ---------------------------------------------------
    c.colors.completion.fg = fg
    c.colors.completion.odd.bg = bg
    c.colors.completion.even.bg = bg1
    c.colors.completion.category.bg = bg2
    c.colors.completion.category.fg = accent
    c.colors.completion.item.selected.bg = bg3
    c.colors.completion.item.selected.fg = accent
    c.colors.completion.item.selected.border.top = bg3
    c.colors.completion.item.selected.border.bottom = bg3
    c.colors.completion.match.fg = accent
    c.colors.completion.scrollbar.bg = bg
    c.colors.completion.scrollbar.fg = bg3

    # -- hints / prompts / messages / downloads ----------------------------
    c.colors.hints.bg = accent
    c.colors.hints.fg = bg
    c.colors.hints.match.fg = bg
    c.colors.keyhint.bg = bg2
    c.colors.keyhint.fg = fg
    c.colors.keyhint.suffix.fg = accent
    c.colors.messages.error.bg = red
    c.colors.messages.error.fg = bg
    c.colors.messages.warning.bg = yellow
    c.colors.messages.warning.fg = bg
    c.colors.messages.info.bg = bg2
    c.colors.messages.info.fg = fg
    c.colors.prompts.bg = bg2
    c.colors.prompts.fg = fg
    c.colors.prompts.selected.bg = bg3
    c.colors.downloads.bar.bg = bg
    c.colors.downloads.start.bg = accent
    c.colors.downloads.start.fg = bg
    c.colors.downloads.stop.bg = green
    c.colors.downloads.stop.fg = bg
    c.colors.downloads.error.bg = red
    c.colors.downloads.error.fg = bg

    # -- pages -------------------------------------------------------------
    c.colors.webpage.bg = bg
    c.colors.webpage.darkmode.enabled = True
    c.colors.webpage.darkmode.algorithm = "lightness-cielab"
    c.colors.webpage.darkmode.policy.images = "smart"

    # -- behaviour ---------------------------------------------------------
    c.auto_save.session = True
    c.tabs.position = "top"
    c.tabs.show = "multiple"
    c.downloads.position = "bottom"
    c.scrolling.smooth = True
    c.url.start_pages = ["about:blank"]
    c.url.default_page = "about:blank"
  '';

  # =========================================================================
  #  waybar — a thin, quiet bar
  # =========================================================================
  # Rofi-driven power menu for the bar's power button.
  powerMenu = pkgs.writeShellScriptBin "power-menu" ''
    chosen=$(printf 'Lock\nLogout\nSuspend\nReboot\nShutdown' \
      | ${pkgs.rofi}/bin/rofi -dmenu -p power -config $HOME/.config/rofi/config.rasi)
    case "$chosen" in
      Lock)     exec ${pkgs.hyprlock}/bin/hyprlock ;;
      Logout)   exec ${pkgs.hyprland}/bin/hyprctl dispatch exit ;;
      Suspend)  exec ${pkgs.systemd}/bin/systemctl suspend ;;
      Reboot)   exec ${pkgs.systemd}/bin/systemctl reboot ;;
      Shutdown) exec ${pkgs.systemd}/bin/systemctl poweroff ;;
    esac
  '';

  # JSON with \uXXXX icon escapes: the Nix '' string keeps the backslash and
  # waybar's JSON parser decodes it to the Nerd Font glyph.
  waybarConfig = ''
    {
      "layer": "top",
      "position": "top",
      "height": 30,
      "spacing": 6,
      "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
      "modules-center": ["clock"],
      "modules-right": ["idle_inhibitor", "cpu", "memory", "temperature", "disk", "backlight", "pulseaudio", "mpris", "network", "bluetooth", "battery", "tray", "custom/power"],

      "hyprland/workspaces": { "format": "{id}", "on-click": "activate" },
      "hyprland/submap": { "format": " {}", "tooltip": false },
      "hyprland/window": { "format": "{title}", "max-length": 70 },

      "clock": { "format": "\uf017 {:%H:%M}", "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>" },

      "idle_inhibitor": { "format": "{icon}", "format-icons": { "activated": "\uf06e", "deactivated": "\uf070" } },

      "cpu":         { "format": "\uf2db {usage}%", "interval": 3, "tooltip": true },
      "memory":      { "format": "\udb80\udf5b {percentage}%", "interval": 5, "tooltip": true },
      "temperature": { "format": "\uf2c7 {temperatureC}°C", "interval": 5, "critical-threshold": 80 },
      "disk":        { "format": "\uf0a0 {percentage_used}%", "path": "/", "interval": 30 },
      "backlight":   { "format": "\uf185 {percent}%" },

      "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026 muted",
        "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
        "on-click": "pavucontrol",
        "scroll-step": 5
      },
      "mpris": { "format": "\uf001 {title}", "max-length": 45, "on-click": "music-menu" },

      "network": {
        "format-wifi": "\uf1eb {essid}",
        "format-ethernet": "\udb80\ude00 {ifname}",
        "format-disconnected": "\uf1eb offline",
        "tooltip-format": "{ipaddr}/{cidr}"
      },
      "bluetooth": {
        "format": "\uf293 {status}",
        "format-disabled": "\uf293 off",
        "format-connected": "\uf293 {device_alias}",
        "tooltip-format": "{controller_alias}  {controller_address}\n{num_connections} connected",
        "on-click": "blueman-manager"
      },
      "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "\uf1e6 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "states": { "warning": 30, "critical": 15 },
        "tooltip-format": "{timeTo}\n{power:>1.2f}W"
      },
      "tray": { "spacing": 8, "icon-size": 16 },
      "custom/power": { "format": "\uf011", "tooltip": "Power", "on-click": "power-menu" }
    }
  '';

  waybarStyle = ''
    * { font-family: "${font}"; font-size: 12px; border: none; border-radius: 0; min-height: 0; }
    window#waybar { background: #${bg}; color: #${fg}; }

    #workspaces button { padding: 0 7px; color: #${dim}; background: transparent; }
    #workspaces button.active { color: #${accent}; }
    #workspaces button:hover { background: #${bg1}; }

    #window { color: #${dim}; padding: 0 10px; }
    #submap { color: #${yellow}; padding: 0 10px; }

    #clock { color: #${accent}; padding: 0 12px; }
    #idle_inhibitor { padding: 0 8px; color: #${dim}; }
    #idle_inhibitor.activated { color: #${accent}; }

    #cpu, #memory, #temperature, #disk, #backlight, #pulseaudio, #mpris,
    #network, #bluetooth, #battery, #tray { padding: 0 9px; color: #${fg}; }

    #temperature.critical { color: #${red}; }
    #pulseaudio.muted { color: #${dim}; }
    #network.disconnected { color: #${dim}; }
    #bluetooth.disabled { color: #${dim}; }
    #bluetooth.connected { color: #${accent}; }
    #battery.charging { color: #${green}; }
    #battery.warning { color: #${yellow}; }
    #battery.critical { color: #${red}; }
    #custom-power { color: #${accent}; padding: 0 10px; }
  '';

  # -------------------------------------------------------------------------
  #  Per-theme files
  # -------------------------------------------------------------------------
  # /etc/xdg/themes/<name>/ holds every recoloured file plus the wallpaper
  # path; `theme-switch` points the user's config at the chosen directory.
  themeDir = name: pal: pkgs.linkFarm "theme-${name}" [
    { name = "hyprland.lua";         path = pkgs.writeText "${name}-hyprland.lua" (recolor pal hyprlandLua); }
    { name = "hyprlock.conf";        path = pkgs.writeText "${name}-hyprlock.conf" (recolor pal hyprlockConf); }
    { name = "kitty.conf";           path = pkgs.writeText "${name}-kitty.conf" (recolor pal kittyConf); }
    { name = "rofi.rasi";            path = pkgs.writeText "${name}-rofi.rasi" (recolor pal rofiConfig); }
    { name = "waybar.css";           path = pkgs.writeText "${name}-waybar.css" (recolor pal waybarStyle); }
    { name = "qutebrowser-config.py"; path = pkgs.writeText "${name}-qutebrowser.py" (recolor pal qutebrowserConfig); }
    { name = "wallpaper";            path = pkgs.writeText "${name}-wallpaper" (wallpaperOf pal.wallpaper); }
  ];
  themesDir = pkgs.linkFarm "themes"
    (lib.mapAttrsToList (n: p: { name = n; path = themeDir n p; }) themes);

  # Like writeShellScriptBin but without `-e`, so best-effort reloads in a
  # half-started session do not abort the script.
  writeSh = name: text: pkgs.writeTextFile {
    inherit name text;
    executable = true;
    destination = "/bin/${name}";
    checkPhase = "${pkgs.bash}/bin/bash -n $out/bin/${name}";
  };

  # ---- theme switcher -----------------------------------------------------
  themeSwitch = writeSh "theme-switch" ''
    #!/bin/sh
    # theme-switch [--apply] — pick a desktop theme with rofi, or re-apply the
    # saved one (used at login). Writes ~/.config/theme and points the user
    # config at /etc/xdg/themes/<name>, then reloads the session.
    THEMES=/etc/xdg/themes
    STATE="$HOME/.config/theme"
    ROFI="${pkgs.rofi}/bin/rofi -dmenu -i -no-custom -config $HOME/.config/rofi/config.rasi"

    current=$(cat "$STATE" 2>/dev/null)
    [ -n "$current" ] || current=slate

    if [ "$1" = "--apply" ]; then
      name=$current
    else
      name=$(ls "$THEMES" 2>/dev/null | $ROFI -p theme -mesg "current: $current")
      [ -n "$name" ] || exit 0
    fi
    [ -d "$THEMES/$name" ] || exit 1

    mkdir -p "$HOME/.config/hypr" "$HOME/.config/kitty" "$HOME/.config/rofi" \
             "$HOME/.config/waybar" "$HOME/.config/qutebrowser"
    ln -sfn "$THEMES/$name/hyprland.lua"          "$HOME/.config/hypr/hyprland.lua"
    ln -sfn "$THEMES/$name/hyprlock.conf"         "$HOME/.config/hypr/hyprlock.conf"
    ln -sfn "$THEMES/$name/kitty.conf"            "$HOME/.config/kitty/kitty.conf"
    ln -sfn "$THEMES/$name/rofi.rasi"             "$HOME/.config/rofi/config.rasi"
    ln -sfn "$THEMES/$name/waybar.css"            "$HOME/.config/waybar/style.css"
    ln -sfn "$THEMES/$name/qutebrowser-config.py" "$HOME/.config/qutebrowser/config.py"
    printf '%s\n' "$name" > "$STATE"

    # Best effort — the session may not be up yet (login).
    ${pkgs.hyprland}/bin/hyprctl reload >/dev/null 2>&1
    ${pkgs.systemd}/bin/systemctl --user restart waybar swaybg >/dev/null 2>&1
    ${pkgs.procps}/bin/pkill -USR1 -x kitty >/dev/null 2>&1
    exit 0
  '';

  # ---- wallpaper for the current theme ------------------------------------
  themedSwaybg = writeSh "themed-swaybg" ''
    #!/bin/sh
    name=$(cat "$HOME/.config/theme" 2>/dev/null)
    [ -n "$name" ] || name=slate
    wl="/etc/xdg/themes/$name/wallpaper"
    [ -r "$wl" ] || wl=/etc/xdg/themes/slate/wallpaper
    exec ${pkgs.swaybg}/bin/swaybg -i "$(cat "$wl")" -m fill
  '';

  # ---- music player -------------------------------------------------------
  # Rofi front-end to mpv: a local library plus YouTube search / stream /
  # download, driven over mpv's IPC socket. Bound to SUPER+SHIFT+M.
  musicMenu = writeSh "music-menu" ''
    #!/bin/sh
    export PATH="${lib.makeBinPath (with pkgs; [ yt-dlp jq netcat-openbsd mpv procps findutils coreutils gnused curl ])}:$PATH"
    SOCK="$XDG_RUNTIME_DIR/music-mpv.sock"
    MUSIC_DIR="$HOME/Music"
    ROFI="${pkgs.rofi}/bin/rofi -dmenu -i -config $HOME/.config/rofi/config.rasi"

    ensure_mpv() {
      if pgrep -f "input-ipc-server=$SOCK" >/dev/null 2>&1; then return 0; fi
      mpv --no-video --idle=yes --force-window=no --input-ipc-server="$SOCK" >/dev/null 2>&1 &
      i=0
      while [ "$i" -lt 30 ] && [ ! -S "$SOCK" ]; do sleep 0.1; i=$((i + 1)); done
    }
    mpvcmd() { printf '%s\n' "$1" | timeout 1 nc -q 0 -U "$SOCK" >/dev/null 2>&1 || true; }
    prop()   { printf '{"command":["get_property","%s"],"request_id":%s}\n' "$2" "$1"; }

    nowline() {
      [ -S "$SOCK" ] || { printf 'Nothing playing'; return 0; }
      printf '%s\n' "$(prop 1 media-title)" "$(prop 2 pause)" \
        | timeout 1 nc -q 0 -U "$SOCK" 2>/dev/null \
        | jq -rs 'def v(i): (map(select(.request_id==i))[0].data // ""); (v(1)) + (if v(2)==true then "  (paused)" else "  (playing)" end)' 2>/dev/null \
        || true
    }
    play_id()   { ensure_mpv; mpvcmd "$(jq -cn --arg u "https://www.youtube.com/watch?v=$1" '{command:["loadfile",$u,"replace"]}')"; }
    play_file() { ensure_mpv; mpvcmd "$(jq -cn --arg p "$1" '{command:["loadfile",$p,"replace"]}')"; }

    # pick <prompt>: read "display<TAB>payload" lines, echo the chosen payload
    pick() {
      tmp=$(mktemp)
      cat > "$tmp"
      idx=$(cut -f1 "$tmp" | $ROFI -p "$1" -format i -no-custom -mesg "$(nowline)")
      if [ -z "$idx" ]; then rm -f "$tmp"; return 1; fi
      sed -n "$((idx + 1))p" "$tmp" | cut -f2-
      rm -f "$tmp"
    }

    case "$1" in
      search)
        q=$($ROFI -p search -mesg "search YouTube")
        [ -n "$q" ] || exit 0
        res=$(mktemp)
        yt-dlp --flat-playlist --no-warnings -J "ytsearch15:$q" 2>/dev/null \
          | jq -r '.entries[]? | [ .title + "  [" + ((.duration // 0)|tostring) + "s] — " + (.uploader // "?"), .id ] | @tsv' > "$res" 2>/dev/null
        [ -s "$res" ] || { rm -f "$res"; exit 0; }
        id=$(pick result < "$res") || exit 0
        rm -f "$res"
        [ -n "$id" ] || exit 0
        case "$(printf 'Play\nDownload' | $ROFI -p action)" in
          Play)     play_id "$id" ;;
          Download) mkdir -p "$MUSIC_DIR"
                    yt-dlp -x --audio-format mp3 --audio-quality 0 --embed-thumbnail --add-metadata \
                      -o "$MUSIC_DIR/%(title)s.%(ext)s" "https://www.youtube.com/watch?v=$id" >/dev/null 2>&1 & ;;
        esac
        ;;
      library)
        [ -d "$MUSIC_DIR" ] || exit 0
        res=$(mktemp)
        find "$MUSIC_DIR" -type f \
          \( -iname '*.mp3' -o -iname '*.m4a' -o -iname '*.opus' -o -iname '*.flac' \
             -o -iname '*.ogg' -o -iname '*.wav' -o -iname '*.aac' -o -iname '*.webm' \) \
          -printf '%f\t%p\n' 2>/dev/null | sort > "$res"
        [ -s "$res" ] || { rm -f "$res"; exit 0; }
        f=$(pick library < "$res") || exit 0
        rm -f "$res"
        [ -n "$f" ] && play_file "$f"
        ;;
      *)
        choice=$(printf '%s\n' "Play / pause" "Stop" "Back 10s" "Forward 10s" \
                   "Search YouTube…" "Library…" \
                 | $ROFI -p music -mesg "$(nowline)")
        case "$choice" in
          "Play / pause")  mpvcmd '{"command":["cycle","pause"]}' ;;
          "Stop")          mpvcmd '{"command":["stop"]}' ;;
          "Back 10s")      mpvcmd '{"command":["seek",-10,"relative"]}' ;;
          "Forward 10s")   mpvcmd '{"command":["seek",10,"relative"]}' ;;
          "Search YouTube…") exec "$0" search ;;
          "Library…")        exec "$0" library ;;
        esac
        ;;
    esac
  '';
in
{
  programs.hyprland = {
    enable = true;
    xwayland.enable = true;
  };

  environment.etc = {
    "xdg/hypr/hyprland.lua".text   = hyprlandLua;
    "xdg/hypr/hyprlock.conf".text  = hyprlockConf;
    "xdg/hypr/hypridle.conf".text  = hypridleConf;
    "xdg/rofi/config.rasi".text    = rofiConfig;
    "xdg/kitty/kitty.conf".text       = kittyConf;
    "xdg/qutebrowser/config.py".text  = qutebrowserConfig;
    "xdg/waybar/config.jsonc".text = waybarConfig;
    "xdg/waybar/style.css".text    = waybarStyle;
    # One directory per theme; theme-switch points the user config at one.
    "xdg/themes".source            = themesDir;
  };

  environment.systemPackages = with pkgs; [
    kitty
    rofi
    waybar
    hyprlock
    hypridle
    swaybg
    powerMenu
    themeSwitch
    musicMenu
    brightnessctl
    playerctl
    pavucontrol
    networkmanagerapplet
    wl-clipboard
    grim
    slurp
  ];

  # The bar's icons are Nerd Font glyphs; without the font they render as boxes.
  fonts.packages = with pkgs; [ nerd-fonts.jetbrains-mono ];

  # Session daemons as systemd user services: at login the Wayland socket is
  # not ready yet, so Hyprland `exec-once` races it. systemd retries until the
  # session has imported its environment — with the start limit disabled, since
  # the first handful of attempts all fail before WAYLAND_DISPLAY exists.
  systemd.user.services.waybar = {
    description = "waybar";
    wantedBy = [ "default.target" ];
    startLimitIntervalSec = 0;
    serviceConfig = {
      ExecStart = "${pkgs.waybar}/bin/waybar -c /etc/xdg/waybar/config.jsonc -s %h/.config/waybar/style.css";
      Restart = "always";
      RestartSec = 3;
    };
  };
  systemd.user.services.swaybg = {
    description = "swaybg wallpaper";
    wantedBy = [ "default.target" ];
    startLimitIntervalSec = 0;
    serviceConfig = {
      ExecStart = "${themedSwaybg}/bin/themed-swaybg";
      Restart = "always";
      RestartSec = 3;
    };
  };

  # Re-assert the saved theme at login: tmpfiles resets the user links to slate
  # at boot, and the compositor may have read them before this ran.
  systemd.user.services.theme-apply = {
    description = "Apply the saved desktop theme";
    wantedBy = [ "default.target" ];
    serviceConfig = {
      Type = "oneshot";
      ExecStart = "${themeSwitch}/bin/theme-switch --apply";
    };
  };
}
