+/* T1 EmbeddedOS: capture the personalized boot image (a bare concatenation of
+ * OSRamdisk+KernelCache+DeviceTree+SEP) and the matching AP ticket from the
+ * current preflight TSS response, for the phase-14 memboot / EFI staging. */
+static void t1_capture_preflight(struct idevicerestore_client_t* client)
+{
+	const char* mbsave = getenv("IDEVICERESTORE_T1_PREFLIGHT_MEMBOOT_SAVE");
+	const char* tksave = getenv("IDEVICERESTORE_T1_PREFLIGHT_TICKET_SAVE");
+	if ((!mbsave || !*mbsave) && (!tksave || !*tksave)) {
+		return;
+	}
+	if (!client->tss) {
+		logger(LL_ERROR, "T1 preflight: no TSS response\n");
+		return;
+	}
+
+	if (mbsave && *mbsave) {
+		const char* comps[] = { "OSRamdisk", "KernelCache", "DeviceTree", "SEP" };
+		unsigned char* buf = NULL;
+		size_t buflen = 0;
+		int i;
+		for (i = 0; i < 4; i++) {
+			char* path = NULL;
+			if (build_identity_get_component_path(client->restore->build_identity, comps[i], &path) < 0 || !path) {
+				logger(LL_ERROR, "T1 preflight: no path for %s\n", comps[i]);
+				continue;
+			}
+			void* cdata = NULL; size_t csize = 0;
+			if (extract_component(client->ipsw, path, &cdata, &csize) < 0) {
+				logger(LL_ERROR, "T1 preflight: extract %s failed\n", comps[i]);
+				free(path);
+				continue;
+			}
+			free(path);
+			void* pdata = NULL; size_t psize = 0;
+			if (personalize_component(client, comps[i], cdata, csize, client->tss, &pdata, &psize) < 0) {
+				logger(LL_ERROR, "T1 preflight: personalize %s failed\n", comps[i]);
+				free(cdata);
+				continue;
+			}
+			free(cdata);
+			unsigned char* nb = realloc(buf, buflen + psize);
+			if (!nb) { free(pdata); free(buf); return; }
+			buf = nb;
+			memcpy(buf + buflen, pdata, psize);
+			buflen += psize;
+			free(pdata);
+			logger(LL_INFO, "T1 preflight: %s -> %zu bytes\n", comps[i], psize);
+		}
+		if (buf) {
+			if (write_file(mbsave, buf, buflen) == 0) {
+				logger(LL_INFO, "T1 preflight: wrote combined memboot (%zu bytes) to %s\n", buflen, mbsave);
+			}
+			free(buf);
+		}
+	}
+
+	if (tksave && *tksave) {
+		unsigned char* data = NULL;
+		unsigned int len = 0;
+		if (client->image4supported) {
+			tss_response_get_ap_img4_ticket(client->tss, &data, &len);
+		} else {
+			tss_response_get_ap_ticket(client->tss, &data, &len);
+		}
+		if (data && len) {
+			if (write_file(tksave, data, len) == 0) {
+				logger(LL_INFO, "T1 preflight: wrote AP ticket (%u bytes) to %s\n", len, tksave);
+			}
+		}
+		free(data);
+	}
+}
