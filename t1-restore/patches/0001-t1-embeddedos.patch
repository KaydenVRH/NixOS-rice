+int restore_send_fdr_memory_commit(struct idevicerestore_client_t* client, plist_t message)
+{
+	restored_error_t restore_error;
+	plist_t dict;
+
+	logger(LL_INFO, "About to handle FDR Memory Commit...\n");
+
+	/* The T1 EmbeddedOS has no system partition to persist FDR data, so the
+	 * device hands it to the host here. Save it (binary plist) for replay in the
+	 * next pass (IDEVICERESTORE_T1_FDR_OUTPUT). */
+	const char* outpath = getenv("IDEVICERESTORE_T1_FDR_OUTPUT");
+	if (outpath && *outpath) {
+		if (plist_write_to_file(message, outpath, PLIST_FORMAT_BINARY, PLIST_OPT_NONE) < 0) {
+			logger(LL_ERROR, "Unable to write FDR memory to %s\n", outpath);
+		} else {
+			logger(LL_INFO, "Saved FDR memory to %s\n", outpath);
+		}
+	}
+
+	/* Acknowledge so the device continues. */
+	dict = plist_new_dict();
+	restore_service_client_t service = _restore_get_service_client_for_data_request(client, message);
+	if (!service) {
+		logger(LL_ERROR, "%s: Unable to connect to service client\n", __func__);
+		return -1;
+	}
+	restore_error = _restore_service_send(service, dict, 0);
+	plist_free(dict);
+	_restore_service_free(service);
+	if (restore_error != RESTORE_E_SUCCESS) {
+		logger(LL_ERROR, "Unable to send FDR memory commit ack (%d)\n", restore_error);
+		return -1;
+	}
+	logger(LL_INFO, "Done handling FDR Memory Commit\n");
+	return 0;
+}
